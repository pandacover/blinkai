# OpenRouter (required) — https://openrouter.ai/keys
# Bun server only; never expose to the browser.
OPENROUTER_API_KEY=

# Optional — default is <app-root>/data
# BLINKAI_DATA_DIR=

# Set to 1 to call real OpenRouter models (Film Plan / Stills / Voiceover / Clips).
# Leave unset for the fast local fake port (recommended for UI work).
# BLINKAI_USE_LIVE_OPENROUTER=1

# Runs complete synchronously by default. Set async via POST /api/runs?async=1 only when needed.
